# Copy to .env and fill in. Never commit .env.

# Neon: pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Neon: direct (unpooled) connection string. Used by Prisma CLI for migrations and seed.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# First admin, created by `npm run db:seed`. Keep the PIN out of git.
SEED_ADMIN_NAME="Lauren Wu"
SEED_ADMIN_PIN=""

# Signs session cookies (32+ random bytes). Generate with: openssl rand -base64 32
SESSION_SECRET=""
